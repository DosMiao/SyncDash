# Everything is stored as LF in this repo. Without this declaration core.autocrlf=true wants to flip
# the working tree to CRLF, while the generator (Script/gen-types.mjs) and every editor write LF — so
# the 23 files under typescript/core/types/generated/ stay modified forever after commit, with an empty `git diff`.
* text=auto eol=lf

# Mac build scripts must be LF, otherwise bash hits a \r and reports command not found
*.command text eol=lf
*.sh      text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf

# Binary: no line-ending or text processing at all
*.png   binary
*.ico   binary
*.tar   binary
*.jsonl binary
